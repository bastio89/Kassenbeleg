# ============================================================
#  Kassenbelege – Konfiguration
#  Kopieren nach .env und anpassen:  cp .env.example .env
# ============================================================

# Passwort der Datenbank (beliebig, nur intern genutzt)
POSTGRES_PASSWORD=bitte-aendern

# Port, unter dem die Web-App erreichbar ist
APP_PORT=3000

# Wer darf die App erreichen?
#   0.0.0.0   = alle Geräte im Heimnetz (auch Gäste im WLAN!) – praktisch für die Ersteinrichtung
#   127.0.0.1 = nur der Server selbst → Zugriff ausschließlich über Tailscale (tailscale serve 3000)
# Empfehlung: nach Einrichtung von Tailscale auf 127.0.0.1 stellen (siehe README).
APP_BIND=0.0.0.0

# Adresse, unter der du die App aufrufst (für Links in Telegram-Nachrichten), z. B.
# https://homeserver.tailXXXX.ts.net  oder  http://192.168.1.10:3000
APP_URL=

# ------------------------------------------------------------
#  KI
# ------------------------------------------------------------
# "ollama" = lokal auf dem Server (Standard, keine Daten verlassen das Haus)
# "openrouter" = Cloud-Modelle über openrouter.ai (schneller/genauer, kostet pro Beleg ~0,1 Cent)
AI_PROVIDER=ollama

# Optional: Wenn die lokale KI scheitert, automatisch OpenRouter versuchen
# AI_FALLBACK=openrouter

# Lokales Modell. qwen2.5:3b braucht ca. 2–3 GB RAM und läuft auf 8-GB-Rechnern.
#   Noch sparsamer:   qwen2.5:1.5b
#   Genauer (≥16 GB): qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b

# Verfahren: "ocr" = Tesseract liest den Text, das Modell strukturiert ihn (empfohlen für 8 GB)
#            "vision" = das Modell bekommt direkt das Foto (braucht OLLAMA_VISION_MODEL, ≥ 12 GB RAM empfohlen)
# Leer lassen = automatisch (lokal: ocr, OpenRouter: vision)
AI_MODE=
# OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Fragen in normaler Sprache ("Wie viel haben wir für Kaffee ausgegeben?"):
# leer = wie AI_PROVIDER. Mit "openrouter" beantwortet ein Cloud-Modell die Fragen
# (versteht freie Formulierungen besser, schickt aber die FRAGE – nicht eure Belege – in die Cloud).
ASK_PROVIDER=

# OpenRouter (nur nötig bei AI_PROVIDER/ASK_PROVIDER=openrouter oder AI_FALLBACK=openrouter)
# Schlüssel erstellen unter https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ------------------------------------------------------------
#  Telegram-Bot (optional)
# ------------------------------------------------------------
# Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram-IDs, die den Bot nutzen dürfen (kommagetrennt). Deine ID bekommst du,
# indem du dem Bot /id schreibst.
TELEGRAM_ALLOWED_USER_IDS=

# Wie viele Tage vor Garantie-Ablauf per Telegram erinnert wird
WARRANTY_REMINDER_DAYS=30

# ------------------------------------------------------------
#  Sicherung außer Haus (optional, dringend empfohlen)
# ------------------------------------------------------------
# Die Datenbank wird jede Nacht nach ./backups gesichert – das liegt aber auf derselben
# Festplatte. Mit RESTIC_REPOSITORY werden Datenbank UND Originalbelege zusätzlich
# verschlüsselt an einen anderen Ort kopiert. Beispiele (siehe README):
#   NAS/USB-Platte:  OFFSITE_PATH=/mnt/nas/kassenbeleg   und   RESTIC_REPOSITORY=/offsite/kassenbeleg
#   Backblaze B2:    RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/mein-bucket
#                    AWS_ACCESS_KEY_ID=…   AWS_SECRET_ACCESS_KEY=…
RESTIC_REPOSITORY=
# Passwort für die Verschlüsselung – GUT AUFBEWAHREN (z. B. Passwortmanager)!
# Ohne dieses Passwort ist die Sicherung nicht wiederherstellbar.
RESTIC_PASSWORD=
OFFSITE_PATH=
# Uhrzeit der täglichen Sicherung (Stunde)
BACKUP_HOUR=3

# ------------------------------------------------------------
#  Optionaler Passwortschutz
# ------------------------------------------------------------
# Nur nötig, wenn die App NICHT nur über Heimnetz/Tailscale erreichbar ist.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
